**/AppsInToss/Editor/AITConfig.asset.meta

# Apps in Toss SDK - 민감한 인증 정보 보호
**/AITCredentials.asset
**/AITCredentials.asset.meta

# Temporary files
*.temp
*~
!Tests~
!Tools~
!sdk-runtime-generator~
!scripts~
!**/Plugins~
!**/Plugins~/**
!**/BuildConfig~
!**/BuildConfig~/**
**/BuildConfig~/node_modules/
# 샘플 프로젝트에 빌드 시 스캐폴드되는 SDK 템플릿 사본 (AITTemplateManager.UpdateConfigFileWithMarkers)
Tests~/E2E/*UnityProject-*/Assets/WebGLTemplates/AITTemplate/BuildConfig~/vite.config.ts
Tests~/E2E/*UnityProject-*/Assets/WebGLTemplates/AITTemplate/BuildConfig~/granite.config.ts

# Legacy folders (replaced with ~ suffix versions)
BuildTemplate/
BuildTemplate.meta
ViteTemplate/
ViteTemplate.meta
sdk-runtime-generator/
sdk-runtime-generator.meta
tools/
tools.meta

# Documentation~ 폴더 (Unity에서 무시되므로 meta 불필요)
!Documentation~

# Unity License files (sensitive)
*.alf
*.ulf

# Embedded Node.js runtime (downloaded automatically)
Tools~/NodeJS/darwin-arm64/
Tools~/NodeJS/darwin-x64/
Tools~/NodeJS/win-x64/
Tools~/NodeJS/linux-x64/
!Tools~/NodeJS/*/README.txt

# SDK generator build artifacts (~ suffix excludes from Unity)
sdk-runtime-generator~/dist/
sdk-runtime-generator~/.tmp/
sdk-runtime-generator~/.temp-csharp-validation/

# Local classifier/E2E debug downloads
.tmp-artifacts/

# E2E Test artifacts
Tests~/E2E/SampleUnityProject*/Library/
Tests~/E2E/SampleUnityProject*/Temp/
Tests~/E2E/SampleUnityProject*/Logs/
Tests~/E2E/SampleUnityProject*/UserSettings/
Tests~/E2E/SampleUnityProject*/ait-build/
Tests~/E2E/SampleUnityProject*/webgl/
Tests~/E2E/SampleUnityProject*/WebGLBuild/
Tests~/E2E/SampleUnityProject*/Builds/
Tests~/E2E/SampleUnityProject*/editmode-results.xml
Tests~/E2E/SampleUnityProject*/Assets/Plugins/E2ETestBridge.jslib*
# WebGLTemplates: SDK 자동 생성 부분만 무시. AITTemplate(튜토리얼 자산)은 커밋.
Tests~/E2E/SampleUnityProject*/Assets/WebGLTemplates/AITTemplate/Runtime/
Tests~/E2E/SampleUnityProject*/Assets/WebGLTemplates/AITTemplate/Runtime.meta
Tests~/E2E/SampleUnityProject*/Assets/WebGLTemplates/AITTemplate/TemplateData/
Tests~/E2E/SampleUnityProject*/Assets/WebGLTemplates/AITTemplate/TemplateData.meta
Tests~/E2E/SampleUnityProject*/Assets/WebGLTemplates/AITTemplate/loading.html
Tests~/E2E/SampleUnityProject*/Assets/WebGLTemplates/AITTemplate/loading.html.meta
Tests~/E2E/build.log
Tests~/E2E/benchmark*.log
Tests~/E2E/temp/
Tests~/E2E/tests/test-results.json
Tests~/E2E/tests/e2e-test-results.json
Tests~/E2E/tests/perf-results-*.json
Tests~/E2E/tests/test-results/
Tests~/E2E/tests/*-screenshot.png

# Unity meta files - most .meta files should be tracked for consistent GUIDs
# Exceptions:
# - License files: sensitive
Unity_v*.alf.meta
.playwright-mcp
*.slnx
package-lock.json
pnpm-lock.yaml
yarn.lock
package-lock.json.meta
pnpm-lock.yaml.meta
yarn.lock.meta

# BuildConfig~의 pnpm-lock.yaml은 커밋 (빌드 시 --frozen-lockfile 사용을 위해)
!**/BuildConfig~/pnpm-lock.yaml

# Tests~/E2E/tests의 pnpm-lock.yaml은 커밋 (E2E 잡이 --frozen-lockfile 사용)
!**/Tests~/E2E/tests/pnpm-lock.yaml

# sdk-runtime-generator~의 pnpm-lock.yaml은 커밋 (Regenerate Lockfiles 워크플로가 재생성·커밋)
!sdk-runtime-generator~/pnpm-lock.yaml

# Editor/FontSubset~, PngRecompress~, AudioTranscode~의 package-lock.json은 커밋
# (on-demand 도구 설치 시 npm ci로 전이 의존성까지 고정하기 위해). *~ 규칙에 걸려
# 디렉토리 자체가 제외되므로(위 line 111) 디렉토리도 함께 unignore 해야 파일 negation이 먹는다.
!Editor/FontSubset~
!Editor/FontSubset~/package-lock.json
!Editor/PngRecompress~
!Editor/PngRecompress~/package-lock.json
!Editor/AudioTranscode~
!Editor/AudioTranscode~/package-lock.json

# Lockfile은 일반적으로 커밋하지 않음 (BuildConfig~, Tests~/E2E/tests, sdk-runtime-generator~,
# Editor/FontSubset~·PngRecompress~·AudioTranscode~ 제외)

# 로컬 전용 내부호스트 denylist (pre-push 훅용) — 커밋 금지. 템플릿: patterns.local.example
.githooks/patterns.local
