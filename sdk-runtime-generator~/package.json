{
  "name": "@apps-in-toss/unity-sdk-generator",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Automatic Unity SDK generator from TypeScript definitions",
  "scripts": {
    "build": "pnpm exec tsc && pnpm run copy-templates",
    "copy-templates": "node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\"",
    "generate": "pnpm run build && node dist/index.js generate",
    "format": "pnpm run build && node dist/index.js format",
    "validate": "vitest run",
    "dev": "tsx src/index.ts generate",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:binding": "vitest run tests/unit/binding.test.ts",
    "test:invariants": "vitest run tests/unit/invariants.test.ts tests/unit/function-mapping.test.ts tests/unit/nested-callback-diagnostic.test.ts tests/unit/field-docs.test.ts tests/unit/differential.test.ts tests/unit/discovery-invariants.test.ts tests/unit/report/changelog-markdown.test.ts tests/unit/playerprefs-adapter.test.ts",
    "test:serialization": "vitest run tests/unit/serialization.test.ts",
    "test:differential": "vitest run tests/unit/differential.test.ts",
    "test:multi-version": "vitest run tests/unit/multi-version.test.ts",
    "changelog:generate": "tsx tests/unit/scripts/generate-changelog.ts"
  },
  "packageManager": "pnpm@11.6.0",
  "dependencies": {
    "@apps-in-toss/web-framework": "3.9.0",
    "commander": "15.0.0",
    "handlebars": "4.7.10",
    "picocolors": "1.1.1",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/node": "^26.6.5",
    "@vitest/ui": "4.1.12",
    "glob": "13.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "web-framework-3.0.1": "npm:@apps-in-toss/web-framework@3.0.1",
    "web-framework-3.0.2": "npm:@apps-in-toss/web-framework@3.0.2",
    "web-framework-3.0.3": "npm:@apps-in-toss/web-framework@3.0.3",
    "web-framework-3.0.4": "npm:@apps-in-toss/web-framework@3.0.4",
    "web-framework-3.0.5": "npm:@apps-in-toss/web-framework@3.0.5",
    "web-framework-3.1.0": "npm:@apps-in-toss/web-framework@3.1.0",
    "web-framework-3.1.1": "npm:@apps-in-toss/web-framework@3.1.1",
    "web-framework-3.2.0": "npm:@apps-in-toss/web-framework@3.2.0",
    "web-framework-3.3.0": "npm:@apps-in-toss/web-framework@3.3.0",
    "web-framework-3.4.0": "npm:@apps-in-toss/web-framework@3.4.0",
    "web-framework-3.4.1": "npm:@apps-in-toss/web-framework@3.4.1",
    "web-framework-3.5.0": "npm:@apps-in-toss/web-framework@3.5.0",
    "web-framework-3.6.0": "npm:@apps-in-toss/web-framework@3.6.0",
    "web-framework-3.7.0": "npm:@apps-in-toss/web-framework@3.7.0",
    "web-framework-3.8.0": "npm:@apps-in-toss/web-framework@3.8.0",
    "web-framework-3.9.0": "npm:@apps-in-toss/web-framework@3.9.0"
  }
}
